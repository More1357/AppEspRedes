generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  nombre         String
  edad           Int?
  peso           Float?
  altura         Int?
  nivelActividad String?   // SEDENTARIO, ACTIVO, MUY_ACTIVO
  rol            String   @default("USER")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  proyectos Proyecto[]  // ← AGREGAR ESTA LÍNEA (es la relación inversa)
}

model Proyecto {
  id        Int      @id @default(autoincrement())
  nombre    String
  usuarioId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}
