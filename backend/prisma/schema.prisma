generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  nombre         String
  rol            String   @default("USER")
  edad           Int?
  peso           Float?
  altura         Int?
  nivelActividad String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  proyectos      Proyecto[]
  rutinas        Rutina[]
}

model Proyecto {
  id        Int      @id @default(autoincrement())
  nombre    String
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rutina {
  id          Int      @id @default(autoincrement())
  titulo      String
  categoria   String   // "Hipertrofia", "Resistencia", "Fuerza", etc.
  duracion    Int      // minutos
  calorias    Int      // calorías estimadas
  ejercicios  String?  // JSON con la lista de ejercicios (opcional)
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
